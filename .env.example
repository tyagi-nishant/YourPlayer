# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# INTERNAL STREAM ENDPOINTS CONFIGURATION (Server-Side Only)
# -----------------------------------------------------------------------------
# Configure playable internal endpoints exclusively via environment variables.
# Add or remove variables at any time — the app reads them dynamically on the
# server and proxies HLS (.m3u8), Direct Video (.mp4/.mkv/.webm), Audio streams,
# M3U playlists, Embeds, or JSON stream APIs without exposing internal URLs.
#
# Option 1: Individual prefixed variables (add or delete any key as needed)
# Format: URL  or  Display Name|URL  or  Display Name|URL|Type
# INTERNAL_ENDPOINT_1=""
# INTERNAL_ENDPOINT_MAIN_STAGE=""
# INTERNAL_ENDPOINT_VOD_SERVER=""
#
# Option 2: Single endpoint variable
# INTERNAL_ENDPOINT=""
#
# Option 3: Bulk list variable (JSON array, JSON map, or comma/newline-separated)
# INTERNAL_ENDPOINTS=""
#
# Optional: Shared authentication for internal endpoints (forwarded server-side)
# INTERNAL_ENDPOINT_AUTH_TOKEN=""
# INTERNAL_ENDPOINT_HEADERS=""
